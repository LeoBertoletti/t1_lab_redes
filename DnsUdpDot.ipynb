    "def query_dot_server(server_ip, hostname, domain_name, timeout=5.0, query_type=1):\n",
    "    \"\"\"\n",
    "    Consulta DNS over TLS (DoT) conforme RFC 7858.\n",
    "    Cada chamada abre uma nova conexão TLS na porta 853.\n",
    "    A mensagem DNS é precedida por um prefixo de 2 bytes com seu tamanho.\n",
    "    \"\"\"\n",
    "    start = time.perf_counter()\n",
    "    context = ssl.create_default_context()\n",
    "    raw_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n",
    "    raw_sock.settimeout(timeout)\n",
    "    tls_sock = context.wrap_socket(raw_sock, server_hostname=hostname)\n",
    "\n",
    "    try:\n",
    "        tls_sock.connect((server_ip, 853))\n",
    "\n",
    "        query = build_dns_query(domain_name, query_type=query_type)\n",
    "        # RFC 7858 §3.3: prefixo de 2 bytes (big-endian) com o tamanho da mensagem\n",
    "        wire_message = struct.pack(\"!H\", len(query)) + query\n",
    "        tls_sock.sendall(wire_message)\n",
    "\n",
    "        # Lê exatamente 2 bytes do prefixo de tamanho da resposta\n",
    "        length_buf = b\"\"\n",
    "        while len(length_buf) < 2:\n",
    "            chunk = tls_sock.recv(2 - len(length_buf))\n",
    "            if not chunk:\n",
    "                raise OSError(\"Conexão encerrada antes de receber o prefixo de tamanho\")\n",
    "            length_buf += chunk\n",
    "        msg_length = struct.unpack(\"!H\", length_buf)[0]\n",
    "\n",
    "        # Lê a resposta completa\n",
    "        response_buf = b\"\"\n",
    "        while len(response_buf) < msg_length:\n",
    "            chunk = tls_sock.recv(msg_length - len(response_buf))\n",
    "            if not chunk:\n",
    "                raise OSError(\"Conexão encerrada antes de receber a resposta completa\")\n",
    "            response_buf += chunk\n",
    "\n",
    "        elapsed = time.perf_counter() - start\n",
    "        decoded = decode_dns_response(response_buf)\n",
    "        ip_answers = [a[\"data\"] for a in decoded[\"answers\"] if a[\"rtype\"] == 1]\n",
    "\n",
    "        return {\n",
    "            \"server\": server_ip, \"hostname\": hostname, \"protocol\": \"DoT\",\n",
    "            \"status\": \"ok\", \"elapsed\": elapsed,\n",
    "            \"decoded\": decoded, \"ips\": ip_answers,\n",
    "            \"bytes_sent\": len(wire_message),\n",
    "            \"bytes_recv\": 2 + msg_length,\n",
    "            \"error\": None,\n",
    "        }\n",
    "    except socket.timeout:\n",
    "        elapsed = time.perf_counter() - start\n",
    "        return {\"server\": server_ip, \"hostname\": hostname, \"protocol\": \"DoT\",\n",
    "                \"status\": \"timeout\", \"elapsed\": elapsed, \"decoded\": None,\n",
    "                \"ips\": [], \"bytes_sent\": 0, \"bytes_recv\": 0, \"error\": \"timeout\"}\n",
    "    except Exception as exc:\n",
    "        elapsed = time.perf_counter() - start\n",
    "        return {\"server\": server_ip, \"hostname\": hostname, \"protocol\": \"DoT\",\n",
    "                \"status\": \"error\", \"elapsed\": elapsed, \"decoded\": None,\n",
    "                \"ips\": [], \"bytes_sent\": 0, \"bytes_recv\": 0, \"error\": str(exc)}\n",
    "    finally:\n",
    "        try:\n",
    "            tls_sock.close()\n",
    "        except Exception:\n",
    "            pass"
   ]
  },
