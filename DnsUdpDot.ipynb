    "def benchmark_dot_servers(domain_name, servers=DOT_SERVERS, iterations=10, timeout=5.0):\n",
    "    stats = []\n",
    "    for srv in servers:\n",
    "        samples, failures, rcodes = [], 0, []\n",
    "        for _ in range(iterations):\n",
    "            r = query_dot_server(srv[\"ip\"], srv[\"hostname\"], domain_name, timeout=timeout)\n",
    "            if r[\"status\"] == \"ok\" and r[\"decoded\"]:\n",
    "                samples.append(r[\"elapsed\"])\n",
    "                rcodes.append(r[\"decoded\"][\"rcode_name\"])\n",
    "            else:\n",
    "                failures += 1\n",
    "        stats.append({\n",
    "            \"name\": srv[\"name\"], \"server\": srv[\"ip\"],\n",
    "            \"hostname\": srv[\"hostname\"], \"protocol\": \"DoT\",\n",
    "            \"queries\": iterations, \"successes\": len(samples), \"failures\": failures,\n",
    "            \"loss_rate\": round((failures / iterations) * 100, 2),\n",
    "            \"avg_ms\": round(mean(samples) * 1000, 2) if samples else None,\n",
    "            \"min_ms\": round(min(samples) * 1000, 2) if samples else None,\n",
    "            \"max_ms\": round(max(samples) * 1000, 2) if samples else None,\n",
    "            \"rcode_mode\": Counter(rcodes).most_common(1)[0][0] if rcodes else None,\n",
    "        })\n",
    "    stats.sort(key=lambda x: (x[\"loss_rate\"], x[\"avg_ms\"] if x[\"avg_ms\"] is not None else float(\"inf\")))\n",
    "    return stats\n",
    "\n",
    "\n",
    "def benchmark_udp_servers(domain_name, servers=UDP_SERVERS_COMPARISON, iterations=10, timeout=2.0):\n",
    "    stats = []\n",
    "    for srv in servers:\n",
    "        samples, failures, rcodes = [], 0, []\n",
    "        for _ in range(iterations):\n",
    "            r = query_dns_server(srv[\"ip\"], domain_name, timeout=timeout)\n",
    "            if r[\"status\"] == \"ok\" and r[\"decoded\"]:\n",
    "                samples.append(r[\"elapsed\"])\n",
    "                rcodes.append(r[\"decoded\"][\"rcode_name\"])\n",
    "            else:\n",
    "                failures += 1\n",
    "        stats.append({\n",
    "            \"name\": srv[\"name\"], \"server\": srv[\"ip\"],\n",
    "            \"hostname\": None, \"protocol\": \"UDP\",\n",
    "            \"queries\": iterations, \"successes\": len(samples), \"failures\": failures,\n",
    "            \"loss_rate\": round((failures / iterations) * 100, 2),\n",
    "            \"avg_ms\": round(mean(samples) * 1000, 2) if samples else None,\n",
    "            \"min_ms\": round(min(samples) * 1000, 2) if samples else None,\n",
    "            \"max_ms\": round(max(samples) * 1000, 2) if samples else None,\n",
    "            \"rcode_mode\": Counter(rcodes).most_common(1)[0][0] if rcodes else None,\n",
    "        })\n",
    "    stats.sort(key=lambda x: (x[\"loss_rate\"], x[\"avg_ms\"] if x[\"avg_ms\"] is not None else float(\"inf\")))\n",
    "    return stats"
   ]
  },
