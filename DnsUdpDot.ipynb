    "def export_benchmark_csv(filename, *benchmark_lists):\n",
    "    fields = [\n",
    "        \"name\", \"server\", \"hostname\", \"protocol\",\n",
    "        \"queries\", \"successes\", \"failures\", \"loss_rate\",\n",
    "        \"avg_ms\", \"min_ms\", \"max_ms\", \"rcode_mode\",\n",
    "    ]\n",
    "    all_rows = [row for lst in benchmark_lists for row in lst]\n",
    "    with open(filename, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
    "        writer = csv.DictWriter(f, fieldnames=fields, extrasaction=\"ignore\")\n",
    "        writer.writeheader()\n",
    "        writer.writerows(all_rows)\n",
    "    print(f\"CSV exportado: {filename}\")\n",
    "\n",
    "export_benchmark_csv(\"benchmark_parte3.csv\", udp_bench, dot_bench2)"
   ]
