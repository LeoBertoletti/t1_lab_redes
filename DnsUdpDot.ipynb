    "def run_dot_multi_server_scan(domain_name, servers=DOT_SERVERS, timeout=5.0):\n",
    "    results = []\n",
    "    for srv in servers:\n",
    "        result = query_dot_server(srv[\"ip\"], srv[\"hostname\"], domain_name, timeout=timeout)\n",
    "        result[\"name\"] = srv[\"name\"]\n",
    "        results.append(result)\n",
    "\n",
    "    consensus = Counter()\n",
    "    for r in results:\n",
    "        for ip in r[\"ips\"]:\n",
    "            consensus[ip] += 1\n",
    "    consensus_ip = consensus.most_common(1)[0][0] if consensus else None\n",
    "\n",
    "    rows = []\n",
    "    for r in results:\n",
    "        decoded = r[\"decoded\"]\n",
    "        rcode_name = decoded[\"rcode_name\"] if decoded else \"N/A\"\n",
    "        notes = []\n",
    "        if r[\"status\"] == \"timeout\":\n",
    "            notes.append(\"timeout\")\n",
    "        elif r[\"status\"] == \"error\":\n",
    "            notes.append(f\"erro: {r['error']}\")\n",
    "        else:\n",
    "            if rcode_name == \"NXDOMAIN\" and consensus_ip:\n",
    "                notes.append(\"possible_blocking_nxdomain\")\n",
    "            if rcode_name == \"REFUSED\":\n",
    "                notes.append(\"refused\")\n",
    "            if any(ip in {\"0.0.0.0\", \"127.0.0.1\"} for ip in r[\"ips\"]):\n",
    "                notes.append(\"nulled_ip\")\n",
    "            if consensus_ip and r[\"ips\"] and consensus_ip not in r[\"ips\"]:\n",
    "                notes.append(\"ip_divergent\")\n",
    "            if rcode_name == \"NOERROR\" and not r[\"ips\"]:\n",
    "                notes.append(\"no_a_records\")\n",
    "        rows.append({\n",
    "            \"name\": r[\"name\"],\n",
    "            \"server\": r[\"server\"],\n",
    "            \"hostname\": r[\"hostname\"],\n",
    "            \"status\": r[\"status\"],\n",
    "            \"time_ms\": round(r[\"elapsed\"] * 1000, 2),\n",
    "            \"rcode\": rcode_name,\n",
    "            \"ips\": r[\"ips\"],\n",
    "            \"bytes_sent\": r[\"bytes_sent\"],\n",
    "            \"bytes_recv\": r[\"bytes_recv\"],\n",
    "            \"notes\": notes,\n",
    "        })\n",
    "\n",
    "    return results, rows, consensus_ip"
   ]
  },
